{
  "name": "@statewalker/indexer-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace-internal search orchestration: SearchPipeline (expand, embed, search, rerank, cite), weighted and reranker blending, mocks. Query parser and intent utilities under ./utils.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-search/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-search/tree/main/packages/indexer-search#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-search.git",
    "directory": "packages/indexer-search"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/indexer-api": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
